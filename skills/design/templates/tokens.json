{
  "$description": "Starter tokens from design init. Every value is a neutral placeholder until a reference in design/references/ confirms it.",
  "$extensions": { "io.github.ultr4nerd.design": { "status": "provisional" } },
  "primitive": {
    "$description": "Raw palette and families. Never used in code; semantic tokens alias these.",
    "color": {
      "$type": "color",
      "neutral": {
        "0": {
          "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }
        },
        "50": {
          "$value": { "colorSpace": "srgb", "components": [0.9647, 0.9647, 0.9569], "hex": "#f6f6f4" }
        },
        "100": {
          "$value": { "colorSpace": "srgb", "components": [0.9216, 0.9176, 0.902], "hex": "#ebeae6" }
        },
        "200": {
          "$value": { "colorSpace": "srgb", "components": [0.851, 0.8431, 0.8235], "hex": "#d9d7d2" }
        },
        "400": {
          "$value": { "colorSpace": "srgb", "components": [0.6314, 0.6196, 0.5922], "hex": "#a19e97" }
        },
        "600": {
          "$value": { "colorSpace": "srgb", "components": [0.4196, 0.4078, 0.3843], "hex": "#6b6862" }
        },
        "800": {
          "$value": { "colorSpace": "srgb", "components": [0.2275, 0.2196, 0.2039], "hex": "#3a3834" }
        },
        "900": {
          "$value": { "colorSpace": "srgb", "components": [0.1294, 0.1255, 0.1137], "hex": "#21201d" }
        }
      },
      "accent": {
        "500": {
          "$value": { "colorSpace": "srgb", "components": [0.2314, 0.4235, 0.9608], "hex": "#3b6cf5" }
        },
        "600": {
          "$value": { "colorSpace": "srgb", "components": [0.1569, 0.3373, 0.851], "hex": "#2856d9" }
        },
        "700": {
          "$value": { "colorSpace": "srgb", "components": [0.1216, 0.2706, 0.6902], "hex": "#1f45b0" }
        }
      },
      "red": {
        "600": {
          "$value": { "colorSpace": "srgb", "components": [0.851, 0.1765, 0.1255], "hex": "#d92d20" }
        },
        "700": {
          "$value": { "colorSpace": "srgb", "components": [0.7059, 0.1373, 0.0941], "hex": "#b42318" }
        }
      },
      "green": {
        "700": {
          "$value": { "colorSpace": "srgb", "components": [0.0235, 0.4627, 0.2784], "hex": "#067647" }
        }
      }
    },
    "font": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"]
      }
    }
  },
  "color": {
    "$type": "color",
    "surface": {
      "$value": "{primitive.color.neutral.0}",
      "$description": "Page and app background"
    },
    "surface-raised": {
      "$value": "{primitive.color.neutral.50}",
      "$description": "Cards, sheets, menus, popovers"
    },
    "on-surface": {
      "$value": "{primitive.color.neutral.900}",
      "$description": "Body text and icons",
      "$extensions": { "io.github.ultr4nerd.design": { "on": ["color.surface", "color.surface-raised"] } }
    },
    "on-surface-muted": {
      "$value": "{primitive.color.neutral.600}",
      "$description": "Secondary text: captions, hints, metadata",
      "$extensions": { "io.github.ultr4nerd.design": { "on": ["color.surface", "color.surface-raised"] } }
    },
    "border": {
      "$value": "{primitive.color.neutral.200}",
      "$description": "Dividers and resting input borders (decorative, no contrast minimum)"
    },
    "primary": {
      "$value": "{primitive.color.accent.600}",
      "$description": "Primary action background, selected state"
    },
    "on-primary": {
      "$value": "{primitive.color.neutral.0}",
      "$description": "Text and icons on primary"
    },
    "link": {
      "$value": "{primitive.color.accent.700}",
      "$description": "Inline links",
      "$extensions": { "io.github.ultr4nerd.design": { "on": ["color.surface", "color.surface-raised"] } }
    },
    "focus": {
      "$value": "{primitive.color.accent.500}",
      "$description": "Focus ring around any interactive element",
      "$extensions": {
        "io.github.ultr4nerd.design": { "on": { "color.surface": "ui", "color.surface-raised": "ui" } }
      }
    },
    "danger": {
      "$value": "{primitive.color.red.700}",
      "$description": "Destructive actions and error text",
      "$extensions": { "io.github.ultr4nerd.design": { "on": ["color.surface"] } }
    },
    "on-danger": {
      "$value": "{primitive.color.neutral.0}",
      "$description": "Text and icons on danger"
    },
    "success": {
      "$value": "{primitive.color.green.700}",
      "$description": "Success text and icons",
      "$extensions": { "io.github.ultr4nerd.design": { "on": ["color.surface"] } }
    }
  },
  "font": {
    "$type": "fontFamily",
    "body": {
      "$value": "{primitive.font.sans}",
      "$description": "UI and body text"
    },
    "display": {
      "$value": "{primitive.font.sans}",
      "$description": "Headlines and brand moments"
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": { "value": 4, "unit": "px" },
      "$description": "Icon to its label; tight inline gaps"
    },
    "sm": {
      "$value": { "value": 8, "unit": "px" },
      "$description": "Between related items; padding inside compact controls"
    },
    "md": {
      "$value": { "value": 16, "unit": "px" },
      "$description": "Default padding of cards and controls; gap between form fields"
    },
    "lg": {
      "$value": { "value": 24, "unit": "px" },
      "$description": "Between groups inside a section"
    },
    "xl": {
      "$value": { "value": 40, "unit": "px" },
      "$description": "Between page sections"
    }
  },
  "radius": {
    "$type": "dimension",
    "control": {
      "$value": { "value": 8, "unit": "px" },
      "$description": "Buttons, inputs, chips"
    },
    "card": {
      "$value": { "value": 12, "unit": "px" },
      "$description": "Cards, sheets, dialogs"
    },
    "pill": {
      "$value": { "value": 9999, "unit": "px" },
      "$description": "Pills, avatars, toggles"
    }
  },
  "shadow": {
    "$type": "shadow",
    "raised": {
      "$value": [
        {
          "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.1216, "hex": "#000000" },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 1, "unit": "px" },
          "blur": { "value": 2, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        },
        {
          "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.0784, "hex": "#000000" },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 4, "unit": "px" },
          "blur": { "value": 12, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      ],
      "$description": "Cards and menus that sit above the surface"
    }
  },
  "ease": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [0.2, 0, 0, 1],
      "$description": "Most UI transitions"
    },
    "exit": {
      "$value": [0.4, 0, 1, 1],
      "$description": "Elements leaving the screen"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": { "value": 120, "unit": "ms" },
        "$description": "Hover and press feedback"
      },
      "base": {
        "$value": { "value": 200, "unit": "ms" },
        "$description": "Opening menus, sheets, toasts"
      }
    }
  },
  "type": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": { "value": 40, "unit": "px" },
        "fontWeight": 700,
        "lineHeight": 1.1,
        "letterSpacing": { "value": -0.5, "unit": "px" }
      },
      "$description": "Hero headlines on marketing surfaces only"
    },
    "title": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": { "value": 24, "unit": "px" },
        "fontWeight": 700,
        "lineHeight": 1.25
      },
      "$description": "Screen and dialog titles"
    },
    "body": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": { "value": 16, "unit": "px" },
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "$description": "Body copy and form values"
    },
    "label": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": { "value": 14, "unit": "px" },
        "fontWeight": 500,
        "lineHeight": 1.4
      },
      "$description": "Buttons, field labels, tabs"
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": { "value": 13, "unit": "px" },
        "fontWeight": 400,
        "lineHeight": 1.4
      },
      "$description": "Captions, hints, metadata"
    }
  }
}
